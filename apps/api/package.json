{
  "name": "@private-assistant/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:init": "node --import tsx src/scripts/init-db.ts",
    "seed": "node --import tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "@private-assistant/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "fastify-plugin": "^5.0.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.2.1",
    "pg": "^8.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
